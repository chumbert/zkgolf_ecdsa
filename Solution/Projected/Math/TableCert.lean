/-! P-256 table point certificates: the quantified theorem that every table entry
equals the corresponding scalar multiple of G. -/
namespace Solution.Projected

open Challenge.Specs.ECDSAP256

/- The quantified table theorem: for every index pair (i, d), the table entry
equals ((4 + d.val) * 4^i.val) • G. -/
theorem table_pt (i : Fin 128) (d : Fin 4) :
  ∃ h, pt (tableX i d) (tableY i d) h = ((4 + d.val) * 4^i.val) • G := by
  fin_cases i <;> fin_cases d
