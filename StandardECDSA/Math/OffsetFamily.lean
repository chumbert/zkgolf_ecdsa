/-
# The concrete bad-equation family of the standard circuit (task T13)

`Math/OffsetConditions.lean` defines the *generic* admissibility predicate
`GoodOffset H hH fam` for an arbitrary `BadFamily`, and
`Math/OffsetCandidates.lean` proves that a family of `m < 1290` injective bad
equations cannot exhaust the 1,290 candidates `[k+1]G`.

This module supplies the missing **instantiation**: the concrete family of bad
equations generated by the actual affine operations of the standard circuit.

## The slots

Every affine addition/doubling in the circuit has a denominator
`x(P) - x(Q)`.  Both `P` and `Q` are of the form `[a]H + B` with `a ∈ {±1, ±2,
±3, ±4}` and `B` independent of `H` (a combination of `G`, `Q`, `R` and the
fixed shift `S`).  Hence `x(P) = x(Q)` forces `P = Q` or `P = -Q`, i.e. one of
the two equations

```text
[a - a']H = B' - B        or        [a + a']H = -(B + B'),
```

whose coefficient is again in `{1, 2, 3, 4}`.  The slots below enumerate those
equations, one per (denominator, sign) pair.

| group | denominators | slots |
|---|---|---|
| `fb0` | `x(S) - x(H)` | 2 |
| `fbWin i` | `x(T_i) - x(A_i)`, `i < 128` | 256 |
| `sh k` | the five shifted-table denominators | 10 |
| `ladStep j` | `x(T_j) - x(C_j)`, `j < 255` | 510 |
| `ladDbl j` | `x(C_j) - x(2C_j)`, `j < 255` | 510 |
| `ladFin` | `x(C_255) - x(-ep)` | 1 |

Total: **1,289 slots**.

The slot index type is written as an explicit nested sum rather than an
inductive so that `Fintype.card` computes by `simp` (no `decide`, no
`maxRecDepth` bump).

## The budget

The plan's T13 budget was 1,039 slots and 1,040 candidates.  The enumeration
below shows that the circuit actually needs **1,289** slots: the plan's count
omits the 128 fixed-base window denominators (`fbWin`, 256 slots).  The
candidate set in `Math/OffsetCandidates.lean` has therefore been enlarged to
`Fin 1290 = 1,289 + 1`, the tight bound the counting argument needs, and
`exists_goodOffset` is instantiated with `famOf` below.

## The one input-only exception

The final `elmTo` denominator `x(C_255) - x(-ep)` gives the two equations
`2H = -(B_255 + [E]G)` (coefficient 2, slot `ladFin`) and `B_255 = [E]G`
(coefficient **0**).  The second is a condition on the *inputs* alone, not on
`H`, so it cannot be a `BadFamily` slot (`BadFamily.coeff_pos`).  For a
standard-valid signature `B_255 = [r]Q + [t]R = -[E]G`, so the condition reads
`[2E]G = O`, i.e. `E ≡ 0 (mod n)`.  It is therefore a genuine extra hypothesis
on the digest, recorded as `digest_nondegenerate` below.

Task T13.
-/

import StandardECDSA.Math.OffsetCandidates
import StandardECDSA.Math.SignatureEquation
import StandardECDSA.Phases.FixedBaseSemantics
import StandardECDSA.Phases.LadderSemantics
import StandardECDSA.Phases.TableSemantics

namespace StandardECDSA.Math

open StandardECDSA StandardECDSA.Gadgets StandardECDSA.Phases
open WeierstrassCurve

/-! ## The slot index type -/

/-- The bad-equation slots of the standard circuit, as an explicit nested sum so
that `Fintype.card` computes definitionally.

* `Bool` — `x(S) = x(H)`: `H = S` (`false`) or `H = -S` (`true`);
* `Fin 128 × Bool` — `x(T_i) = x(A_i)` in fixed-base window `i`;
* `Fin 5 × Bool` — the five shifted-table denominators;
* `Fin 255 × Bool` — `x(T_j) = x(C_j)` at ladder step `j`;
* `Fin 255 × Bool` — `x(C_j) = x(2C_j)` at ladder step `j`;
* `Unit` — `x(C_255) = x(-ep)` in the final `elmTo`. -/
abbrev SlotIx : Type :=
  Bool ⊕ (Fin 128 × Bool) ⊕ (Fin 5 × Bool) ⊕ (Fin 255 × Bool) ⊕ (Fin 255 × Bool) ⊕ Unit

/-! ## The coefficients -/

/-- The coefficient `c` of the equation `[c]H = B` attached to a slot. -/
def coeffOf : SlotIx → Nat
  | .inl _ => 1
  | .inr (.inl _) => 1
  | .inr (.inr (.inl (k, s))) => if k.val = 0 ∧ s = false then 1 else 3
  | .inr (.inr (.inr (.inl (_, s)))) => if s then 2 else 4
  | .inr (.inr (.inr (.inr (.inl (_, s))))) => if s then 3 else 1
  | .inr (.inr (.inr (.inr (.inr _)))) => 2

/-- Every slot coefficient is positive. -/
theorem coeffOf_pos (s : SlotIx) : 0 < coeffOf s := by
  rcases s with b | ⟨i, b⟩ | ⟨k, b⟩ | ⟨j, b⟩ | ⟨j, b⟩ | u
  · cases b <;> simp [coeffOf]
  · cases b <;> simp [coeffOf]
  · cases b <;> (simp only [coeffOf]; split <;> omega)
  · cases b <;> simp [coeffOf]
  · cases b <;> simp [coeffOf]
  · simp [coeffOf]

/-- Every slot coefficient is below the group order. -/
theorem coeffOf_lt (s : SlotIx) : coeffOf s < n := by
  have hn : 7 < n := by decide
  rcases s with b | ⟨i, b⟩ | ⟨k, b⟩ | ⟨j, b⟩ | ⟨j, b⟩ | u
  · cases b <;> (simp only [coeffOf]; omega)
  · cases b <;> (simp only [coeffOf]; omega)
  · cases b <;> (simp only [coeffOf]; split <;> omega)
  · cases b <;> (simp only [coeffOf]; split <;> omega)
  · cases b <;> (simp only [coeffOf]; split <;> omega)
  · simp only [coeffOf]; omega

/-! ## The targets

Each target is a point built from `G`, `Q`, `R` and the fixed shift `S`, and is
therefore independent of the offset `H`.  The bit-dependent coefficients
(`winSum`, `bitSum`, `bitSumT`, `rBitAt`, `tBitAt`) are read off the
environment, exactly as the circuit reads them.
-/

/-- The `Q`/`R` part of the ladder accumulator after `j` steps:
`B_j = [bitSum_j]Q + [bitSumT_j]R`. -/
noncomputable def ladOff (env : Environment Fp) (Qpt Rpt : Affine.Point Wp)
    (rb sb : Vector E 256) (j : Nat) : Affine.Point Wp :=
  (bitSum env rb j) • Qpt + (bitSumT env sb j) • Rpt

/-- The `H`-coefficient sign of the ladder accumulator after `j` steps:
`ladAccH j = σ'_j • H` with `σ'_j = (-1)^(j+1)`. -/
def ladSign (j : Nat) : ℤ := (-1 : ℤ) ^ (j + 1)

/-- The right-hand side `B` of the equation `[coeffOf s]H = B` attached to a
slot. -/
noncomputable def targetOf (env : Environment Fp) (eb rb sb : Vector E 256)
    (Qpt Rpt : Affine.Point Wp) : SlotIx → Grp
  | .inl false => shiftPt.toProjective
  | .inl true => (-shiftPt).toProjective
  | .inr (.inl (i, false)) =>
      (tablePt i.val (digitOf env eb i.val) + shiftPt
        + -(WeierstrassCurve.Projective.Point.toAffineLift
              (winSum env eb i.val • Gpt))).toProjective
  | .inr (.inl (i, true)) =>
      (-(tablePt i.val (digitOf env eb i.val)) + shiftPt
        + -(WeierstrassCurve.Projective.Point.toAffineLift
              (winSum env eb i.val • Gpt))).toProjective
  | .inr (.inr (.inl (k, s))) =>
      if k.val = 0 then 0
      else if k.val = 1 then (if s then (-Qpt).toProjective else Qpt.toProjective)
      else if k.val = 2 then (if s then (-Rpt).toProjective else Rpt.toProjective)
      else if k.val = 3 then
        (if s then (-Rpt + -Qpt).toProjective else (Rpt + -Qpt).toProjective)
      else (if s then (-Qpt + (-2 : ℤ) • Rpt).toProjective else (-Qpt).toProjective)
  | .inr (.inr (.inr (.inl (j, false)))) =>
      (ladSign j.val • (ladOff env Qpt Rpt rb sb j.val
        + -((rBitAt env rb j.val) • Qpt) + -((tBitAt env sb j.val) • Rpt))).toProjective
  | .inr (.inr (.inr (.inl (j, true)))) =>
      (ladSign j.val • (-(ladOff env Qpt Rpt rb sb j.val)
        + -((rBitAt env rb j.val) • Qpt) + -((tBitAt env sb j.val) • Rpt))).toProjective
  | .inr (.inr (.inr (.inr (.inl (j, _))))) =>
      (-(ladSign j.val) • (ladOff env Qpt Rpt rb sb j.val)).toProjective
  | .inr (.inr (.inr (.inr (.inr _)))) =>
      (-(ladOff env Qpt Rpt rb sb 255
        + WeierstrassCurve.Projective.Point.toAffineLift
            (digestNat env eb • Gpt))).toProjective

/-! ## The family -/

/-- **The concrete bad-equation family of the standard circuit.** -/
noncomputable def famOf (env : Environment Fp) (eb rb sb : Vector E 256)
    (Qpt Rpt : Affine.Point Wp) : BadFamily Grp where
  m := Fintype.card SlotIx
  coeff := fun i => coeffOf ((Fintype.equivFin SlotIx).symm i)
  coeff_pos := fun i => coeffOf_pos _
  coeff_lt := fun i => coeffOf_lt _
  target := fun i => targetOf env eb rb sb Qpt Rpt ((Fintype.equivFin SlotIx).symm i)

/-- The family has exactly 1,289 slots. -/
theorem famOf_m (env : Environment Fp) (eb rb sb : Vector E 256)
    (Qpt Rpt : Affine.Point Wp) : (famOf env eb rb sb Qpt Rpt).m = 1289 := by
  simp only [famOf, SlotIx, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin,
    Fintype.card_bool, Fintype.card_unit]

/-- The family size is exactly one below the candidate count, so the counting
argument of `exists_goodOffset` applies with no slack. -/
theorem famOf_m_lt_candidates (env : Environment Fp) (eb rb sb : Vector E 256)
    (Qpt Rpt : Affine.Point Wp) : (famOf env eb rb sb Qpt Rpt).m < 1290 := by
  rw [famOf_m]
  norm_num

/-- **The concrete safe-offset existence theorem for the standard circuit.**  For
every environment and every pair of input points there is a candidate
`[k+1]G`, `k < 1290`, whose offset avoids every one of the 1,289 bad equations
of `famOf`. -/
theorem exists_goodOffset_famOf (env : Environment Fp) (eb rb sb : Vector E 256)
    (Qpt Rpt : Affine.Point Wp) :
    ∃ k : Fin 1290, (famOf env eb rb sb Qpt Rpt).Avoids (offsetCandidate k) :=
  exists_goodOffset _ (famOf_m_lt_candidates env eb rb sb Qpt Rpt)

/-- The number of *denominators* (as opposed to equations) the circuit must keep
away from zero: 1 (shift) + 128 (windows) + 5 (tables) + 255 + 255 + 2 (ladder)
= 646.  Each contributes two equations, except the final `elmTo`, whose second
equation is input-only. -/
theorem denominator_count : 1 + 128 + 5 + 255 + 255 + 2 = 646 := rfl

/-- The input-only exception of the final `elmTo`: the second equation
`B_255 = [E]G` has coefficient zero, so it is not a `BadFamily` slot.  For a
standard-valid signature `B_255 = -[E]G`, so the condition is `[2E]G = O`. -/
def digest_nondegenerate (E : Nat) : Prop := (2 * E) % n ≠ 0

end StandardECDSA.Math
